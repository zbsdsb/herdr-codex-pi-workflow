{
  "schema_version": 3,
  "state_schema_version": 4,
  "active_profile": "default",
  "roles": {
    "coordinator": { "kind": "pi", "model": "pi/default", "thinking": "high" },
    "planner": { "kind": "codex", "model": "codex/default", "reasoning_effort": "high" },
    "implementer": { "kind": "pi", "model": "pi/default", "thinking": "high" },
    "reviewer": { "kind": "codex", "model": "codex/default", "reasoning_effort": "high" },
    "deployer": { "kind": "pi", "model": "pi/default", "thinking": "high" },
    "preflight": { "kind": "pi", "model": "pi/default", "thinking": "high" }
  },
  "profiles": {
    "default": { "roles": {} }
  },
  "workflow": {
    "mode_selection": "risk-based",
    "default_mode": "standard",
    "available_modes": ["quick-code", "standard", "release"],
    "require_plan_approval": true,
    "review_mode": "tiered",
    "require_finding_registry": true,
    "require_remediation_report": true,
    "require_scope_delta": true,
    "pause_blocks_transitions": true,
    "allow_legacy_schema_resume": false,
    "forbid_sleep_based_orchestration": true,
    "agent_wait_strategy": "nonblocking-prompt-artifact-verdict",
    "forbid_blocking_prompt_wait": true,
    "build_authority": "project-ci",
    "allow_local_diagnostic_compile": true,
    "allow_local_release_build": false,
    "require_user_confirmation_before_release": true,
    "strict_state_transitions": true,
    "run_lock": "exclusive-directory-lock",
    "state_revision": true,
    "pending_mutation_recovery": true,
    "decision_policy": "latest-scoped-decision-wins",
    "manifest_cli_override": false,
    "require_delivery_manifest": true,
    "allow_placeholder_delivery_artifacts": false,
    "auto_complete_delivery": false,
    "complete_notification_requires_explicit_run": true,
    "post_delivery_triage": true,
    "test_environment": "approved-test-environment",
    "delivery_evidence_runner": "bru",
    "delivery_evidence_timeout_ms": 120000,
    "auto_execute_delivery_evidence": false,
    "max_implementation_rounds": 3,
    "normal_implementation_rounds": 2,
    "max_attempts_per_finding_family": 1,
    "architecture_gate_on": [
      "reopened_finding_family",
      "new_transaction_boundary",
      "new_lock_boundary",
      "new_recovery_boundary",
      "scope_expansion"
    ],
    "plan_freeze": true,
    "escalation_round": 3,
    "hard_stop_round": 3,
    "automatic_model_escalation": false,
    "plan_revision_on": ["plan_gap", "scope_gap", "architecture_gap", "repeated_finding"],
    "do_not_count_as_round": ["workflow_failure", "environment_failure", "missing_artifact"]
  }
}
